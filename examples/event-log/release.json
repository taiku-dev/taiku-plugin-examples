{
  "format": 1,
  "manifest": {
    "id": "example.event-log",
    "name": "Event Log",
    "version": "1.0.0",
    "author": "taiku",
    "description": "Log all session events in real time",
    "tagline": "Real-time event stream viewer",
    "homepageUrl": "https://taiku.live",
    "documentationUrl": "https://docs.taiku.live/docs/plugins-and-developers/built-in-plugins#event-log",
    "supportUrl": "https://github.com/taiku-dev/taiku-plugins/issues",
    "fundingUrl": "https://github.com/sponsors/nathanzhao",
    "bugsUrl": "https://github.com/taiku-dev/taiku-plugins/issues",
    "repository": "taiku-dev/taiku-plugin-examples",
    "license": "MIT",
    "keywords": [
      "taiku",
      "events",
      "logs",
      "debugging",
      "monitoring"
    ],
    "categories": [
      "monitoring",
      "devtools"
    ],
    "permissions": [
      "session.read",
      "events.subscribe",
      "agent.events",
      "ui.panel",
      "ui.toolbar.custom",
      "hotkey.register"
    ],
    "panels": [
      {
        "id": "event-log-panel",
        "title": "Event Log",
        "position": "bottom",
        "htmlUrl": "panel.html",
        "defaultHeight": 240
      }
    ],
    "toolbarActions": [
      {
        "id": "open-event-log",
        "label": "Event Log",
        "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"22 12 18 12 15 21 9 3 6 12 2 12\"/></svg>",
        "panelId": "event-log-panel"
      }
    ],
    "hotkeys": [
      {
        "id": "toggle-event-log",
        "label": "Toggle Event Log",
        "hotkey": "Cmd+Shift+Y",
        "category": "Plugins",
        "action": {
          "type": "openPanel",
          "panelId": "event-log-panel"
        }
      }
    ]
  },
  "files": {
    "README.md": {
      "sha256": "c6e54a5e5cef9e339a734385df18a825f613fde5c52f3c4f739c77afc7d9134a",
      "type": "application/octet-stream"
    },
    "panel.html": {
      "sha256": "f4fd93f2919f15632c2fb535bacc84d84c4ca7ec79670fd16311f70203f3e9cc",
      "type": "text/html"
    }
  }
}
