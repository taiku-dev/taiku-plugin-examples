{
  "id": "example.music-player",
  "name": "Music Player",
  "version": "1.0.0",
  "author": "taiku",
  "description": "Upload and play music while coding. Sync playback with remote collaborators.",
  "tagline": "Collaborative coding tunes",
  "homepageUrl": "https://taiku.live",
  "documentationUrl": "https://docs.taiku.live/docs/plugins-and-developers/built-in-plugins#music-player",
  "supportUrl": "https://github.com/taiku-dev/taiku-plugins/issues",
  "fundingUrl": "https://github.com/sponsors/nathanzhao",
  "bugsUrl": "https://github.com/taiku-dev/taiku-plugins/issues",
  "license": "MIT",
  "keywords": [
    "taiku",
    "music",
    "audio",
    "collaboration",
    "storage"
  ],
  "categories": [
    "productivity",
    "collaboration"
  ],
  "permissions": [
    "ui.panel",
    "ui.toolbar.custom",
    "ui.toast",
    "events.subscribe",
    "events.broadcast",
    "storage.read",
    "storage.write",
    "session.read",
    "hotkey.register"
  ],
  "panels": [
    {
      "id": "music-panel",
      "title": "Music Player",
      "position": "sidebar",
      "htmlUrl": "panel.html",
      "defaultWidth": 300,
      "defaultHeight": 340,
      "persistPosition": true
    }
  ],
  "toolbarActions": [
    {
      "id": "open-music",
      "label": "Music",
      "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 18V5l12-2v13\"/><circle cx=\"6\" cy=\"18\" r=\"3\"/><circle cx=\"18\" cy=\"16\" r=\"3\"/></svg>",
      "panelId": "music-panel"
    }
  ],
  "hotkeys": [
    {
      "id": "toggle-music",
      "label": "Toggle Music Player",
      "hotkey": "Cmd+Shift+M",
      "category": "Plugins",
      "action": {
        "type": "openPanel",
        "panelId": "music-panel"
      }
    }
  ]
}
