{
  "format": 1,
  "manifest": {
    "id": "example.integrations",
    "name": "Integrations Demo",
    "version": "0.1.0",
    "author": "taiku",
    "description": "Connect a Composio app via OAuth, list its tools, and run one — demonstrates the integrations API",
    "tagline": "Call 800+ SaaS tools from a plugin via Composio",
    "homepageUrl": "https://taiku.live",
    "documentationUrl": "https://docs.taiku.live/docs/plugins-and-developers/external-integrations",
    "supportUrl": "https://github.com/taiku-dev/taiku-plugins/issues",
    "fundingUrl": "https://github.com/sponsors/nathanzhao",
    "bugsUrl": "https://github.com/taiku-dev/taiku-plugins/issues",
    "license": "MIT",
    "keywords": [
      "taiku",
      "composio",
      "integrations",
      "oauth",
      "github"
    ],
    "categories": [
      "devtools",
      "productivity"
    ],
    "permissions": [
      "integrations.read",
      "integrations.connect",
      "integrations.execute",
      "ui.panel",
      "ui.toolbar.custom",
      "ui.toast"
    ],
    "integrations": [
      "github"
    ],
    "panels": [
      {
        "id": "integrations-panel",
        "title": "Integrations Demo",
        "position": "sidebar",
        "htmlUrl": "panel.html",
        "defaultWidth": 360
      }
    ],
    "toolbarActions": [
      {
        "id": "open-integrations",
        "label": "Integrations Demo",
        "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71\"/><path d=\"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71\"/></svg>",
        "panelId": "integrations-panel"
      }
    ]
  },
  "files": {
    "README.md": {
      "sha256": "4342e5836218683d5eaa47b97d39f717e01c1e8b23934da3feb65304ca88d49b",
      "type": "application/octet-stream"
    },
    "panel.html": {
      "sha256": "0e8c2d9600b824ff3c4c3278d71eb1ae0c2af4fb3f566d65fc58eea66ad925c4",
      "type": "text/html"
    }
  }
}
