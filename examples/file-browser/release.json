{
  "format": 1,
  "manifest": {
    "id": "example.file-browser",
    "name": "File Browser",
    "version": "0.2.0",
    "author": "taiku",
    "description": "Browse and open files from the session working directory",
    "tagline": "Quick file explorer for your session",
    "homepageUrl": "https://taiku.live",
    "documentationUrl": "https://docs.taiku.live/docs/plugins-and-developers/built-in-plugins#file-browser",
    "supportUrl": "https://github.com/taiku-dev/taiku-plugins/issues",
    "fundingUrl": "https://github.com/sponsors/nathanzhao",
    "bugsUrl": "https://github.com/taiku-dev/taiku-plugins/issues",
    "repository": "taiku-dev/taiku-plugin-examples",
    "license": "MIT",
    "keywords": [
      "taiku",
      "files",
      "filesystem",
      "navigation"
    ],
    "categories": [
      "devtools"
    ],
    "permissions": [
      "session.read",
      "fs.list",
      "ui.open",
      "ui.panel",
      "ui.toolbar.custom",
      "ui.toast"
    ],
    "panels": [
      {
        "id": "file-browser-panel",
        "title": "File Browser",
        "position": "sidebar",
        "htmlUrl": "panel.html",
        "defaultWidth": 300
      }
    ],
    "toolbarActions": [
      {
        "id": "open-file-browser",
        "label": "File Browser",
        "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z\"/></svg>",
        "panelId": "file-browser-panel"
      }
    ]
  },
  "files": {
    "README.md": {
      "sha256": "0802e918c1acc6b1a556a1fe5bd99156c476149fda593e5d4f50502f60dd2b47",
      "type": "application/octet-stream"
    },
    "panel.html": {
      "sha256": "b3f332a95bf9cf243aa3c79fa91b8d4575e80821b09897974c62a7121e150886",
      "type": "text/html"
    }
  }
}
